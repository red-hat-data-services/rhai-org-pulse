{
  "name": "org-pulse-ai-eng",
  "private": true,
  "version": "1.0.406",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "vite",
    "dev:server": "node -r dotenv/config server/index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.mjs",
    "test:watch": "vitest",
    "test:smoke": "playwright test tests/smoke",
    "test:integration": "playwright test tests/integration",
    "lint": "eslint .",
    "validate:modules": "node node_modules/@org-pulse/core/scripts/validate-modules.js",
    "validate:platform": "node node_modules/@org-pulse/core/scripts/validate-platform.js",
    "validate:openapi": "cp scripts/openapi-route-count.json node_modules/@org-pulse/core/scripts/ && node node_modules/@org-pulse/core/scripts/validate-openapi.js",
    "validate:dockerfile-deps": "node scripts/validate-dockerfile-deps.js",
    "update:view-owners": "node scripts/update-view-owners.js",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@octokit/rest": "^22.0.1",
    "@org-pulse/core": "^2.0.79",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.3.0",
    "adm-zip": "^0.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "js-yaml": "^5.4.1",
    "mermaid": "^11.17.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,vue}": "eslint --fix"
  },
  "overrides": {
    "swagger-jsdoc": {
      "brace-expansion": "5.0.9"
    },
    "@apidevtools/json-schema-ref-parser": {
      "js-yaml": "4.3.1"
    }
  }
}
