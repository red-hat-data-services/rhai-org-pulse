{
  "name": "Releases",
  "slug": "releases",
  "defaultEnabled": true,
  "description": "Unified release lifecycle: planning, execution tracking, and delivery readiness",
  "icon": "rocket",
  "order": 3,
  "requires": ["customer-insights"],
  "client": {
    "entry": "./client/index.js",
    "navItems": [
      { "id": "registry", "label": "Manage", "icon": "Database", "requireRole": "planning-manager" },
      { "id": "schedule", "label": "Schedule", "icon": "CalendarDays" },
      { "id": "plan", "label": "Plan", "icon": "ClipboardList", "default": true },
      { "id": "execute", "label": "Execute", "icon": "GitBranch" },
      { "id": "deliver", "label": "Deliver", "icon": "Rocket" },
      { "id": "reports", "label": "Reports", "icon": "BarChart3" },
      { "id": "audit", "label": "Audit", "icon": "History" }
    ],
    "sotuWidgets": [
      {
        "id": "schedule",
        "name": "Release Schedule",
        "description": "Upcoming release milestones with countdowns",
        "component": "./client/widgets/ScheduleWidget.vue",
        "defaultSize": "half",
        "icon": "CalendarDays",
        "category": "releases"
      }
    ],
    "settingsComponent": "./client/components/ReleasesSettings.vue",
    "hiddenRoutes": {
      "feature-detail": "execute"
    }
  },
  "server": {
    "entry": "./server/index.js"
  },
  "secrets": {
    "platform": ["jira", "github", "google"],
    "module": [
      {
        "key": "PRODUCT_PAGES_CLIENT_ID",
        "description": "OAuth client ID for Product Pages (production)",
        "required": false,
        "group": "product-pages-auth"
      },
      {
        "key": "PRODUCT_PAGES_CLIENT_SECRET",
        "description": "OAuth client secret for Product Pages",
        "required": false,
        "group": "product-pages-auth"
      },
      {
        "key": "PRODUCT_PAGES_TOKEN",
        "description": "Personal bearer token for Product Pages (local dev fallback)",
        "required": false,
        "group": "product-pages-auth",
        "exclusive": true
      },
      {
        "key": "FEATURE_TRAFFIC_GITLAB_TOKEN",
        "description": "GitLab PAT for CI artifact fetching (overrides GITLAB_TOKEN)",
        "required": false
      },
      {
        "key": "SMARTSHEET_API_TOKEN",
        "description": "SmartSheet API token for release discovery",
        "required": false
      },
      {
        "key": "CUSTOMER_PORTAL_OFFLINE_TOKEN",
        "description": "Red Hat API offline token used to resolve customer names from Jira Linked Cases",
        "required": false
      },
      {
        "key": "DRAFT_PLANS_GITLAB_TOKEN",
        "description": "GitLab PAT for draft plans data fetching (overrides GITLAB_TOKEN)",
        "required": false
      },
      {
        "key": "GITLAB_CEE_TOKEN",
        "description": "GitLab PAT for gitlab.cee.redhat.com (read_api scope). Optional — maturity data is fetched without authentication by default. Provide a token for improved rate limits.",
        "required": false
      },
      {
        "key": "GOOGLE_OAUTH_CLIENT_ID",
        "description": "Org Pulse Google OAuth client ID used with connected user credentials",
        "required": false,
        "group": "google-user-auth"
      },
      {
        "key": "GOOGLE_OAUTH_CLIENT_SECRET",
        "description": "Org Pulse Google OAuth client secret used with connected user credentials",
        "required": false,
        "group": "google-user-auth"
      },
      {
        "key": "AIPCC_MILESTONES_GOOGLE_USER",
        "description": "Preferred connected Org Pulse Google user for AIPCC milestone refreshes",
        "required": false,
        "group": "google-user-auth"
      }
    ]
  },
  "export": {
    "files": [
      { "path": "releases/registry.json", "notes": "Canonical release registry" },
      { "path": "releases/aipcc-milestones.json", "notes": "Cached AIPCC milestone schedule from Google Sheets" },
      { "path": "releases/execution/index.json", "notes": "Feature index with summary metrics" },
      { "path": "releases/execution/features/*.json", "notes": "Per-feature detail files" },
      { "path": "releases/rhoai-component-architectures/latest.json", "notes": "RHOAI component architecture support matrix" }
    ]
  }
}
